{
  "name": "songhub",
  "version": "1.0.0",
  "private": true,
  "description": "SongHub — an AI-native personal music streaming platform: hybrid AI search, Shazam-style identification, in-app web browser and temporary offline playback.",
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "index:audio": "tsx scripts/build-index.ts",
    "verify": "npm run typecheck && npm run test",
    "test:audio": "vitest run tests/audio-synth.test.ts tests/fingerprint.test.ts tests/identify.test.ts",
    "test:ui": "vitest run tests/ui",
    "test:web": "vitest run tests/web-music.test.ts"
  },
  "dependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "mp4-muxer": "^5.2.2",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.4",
    "jsdom": "^30.1.3",
    "tsx": "^4.20.6",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=20"
  }
}
